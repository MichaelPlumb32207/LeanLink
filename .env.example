# Neon (use pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth (step 2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Single allowed user
ALLOWED_USER_EMAIL="meplumb@gmail.com"

# Job runner (generate with: openssl rand -base64 32)
INTERNAL_JOB_SECRET=""
CRON_SECRET=""

# xAI / Grok (lean inference + live OSINT search)
XAI_API_KEY=""
XAI_MODEL="grok-4.3"

# Google Maps — Street View Static API only (image + metadata are the same API product).
# Billing required. For Vercel/server use: do not restrict key to HTTP referrers.
GOOGLE_MAPS_API_KEY=""
# grok-full | apify-modular | modular-targeted | modular-synthesize (batch jobs only)
ENRICHMENT_MODE="grok-full"

# Full-file inference worker — leave unset/false until per-voter POC is validated
# LEANLINK_ENABLE_BATCH_INFERENCE="false"

# FEC Open API — direct individual-contribution lookup (free; get key at api.data.gov)
FEC_API_KEY=""
# FEC_REQUEST_INTERVAL_MS="4000"
# FEC_SWEEP_BATCH_SIZE="120"

# Apify — deterministic fetch layer for apify-modular (Google Search + page crawl)
APIFY_API_TOKEN=""
# APIFY_GOOGLE_SEARCH_ACTOR="apify/google-search-scraper"
# APIFY_WEB_CRAWLER_ACTOR="apify/website-content-crawler"
# APIFY_ENABLE_GOOGLE_SEARCH="true"
# APIFY_ENABLE_WEB_CRAWLER="true"
# APIFY_MAX_SEARCH_QUERIES="5"
# APIFY_MAX_CRAWL_URLS="2"
# APIFY_RUN_TIMEOUT_SEC="120"

# Exa — retrieval only (people index + web/news + contents). Judgment stays on xAI.
# Get a key at https://dashboard.exa.ai/api-keys — used by scripts/probe-exa-people.ts
# and (future) exa-modular enrichment mode. Not a data-broker path; public indexes only.
EXA_API_KEY=""
# EXA_NUM_RESULTS="5"
# EXA_PEOPLE_MAX_CANDIDATES="3"